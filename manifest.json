{
  "manifest_version": 3,
  "name": "Florence Automator",
  "version": "2.5.15",
  "description": "Automator sidebar for Research Binders",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://us.v2.researchbinders.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://us.v2.researchbinders.com/*"
      ],
      "js": [
        "Florence Extension.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
